/* ---------- البطاقات التعليمية SM-2 ---------- */
async function renderFlashcards() {
  const cards = await db.getAll('flashcards');
  const due = cards.filter((c) => (c.nextReview || 0) <= Date.now());
  $('fc-stats-badge').textContent = `${due.length} للمراجعة / ${cards.length} الإجمالي`;
  const stage = $('fc-review-stage');

  if (!due.length) {
    stage.innerHTML = '<div class="meta">لا توجد بطاقات مستحقة للمراجعة حالياً. أضف بطاقات جديدة أو ولّدها من كتابك.</div>';
    return;
  }
  const card = due[state.fcIndex % due.length];
  stage.innerHTML = `
    <div id="fc-card-box" class="flashcard-3d">${esc(state.fcFlipped ? card.back : card.front)}</div>
    <div class="inline-row center">
      <button class="btn btn-sm" data-rate-fc="1" data-fc-id="${card.id}">صعب (أعد قريباً)</button>
      <button class="btn btn-sm btn-primary" data-rate-fc="3" data-fc-id="${card.id}">جيد</button>
      <button class="btn btn-sm" data-rate-fc="5" data-fc-id="${card.id}">متقن (سهل)</button>
    </div>`;
  $('fc-card-box').onclick = () => { state.fcFlipped = !state.fcFlipped; renderFlashcards(); };
}

async function rateFlashcard(id, quality) {
  const card = await db.get('flashcards', id);
  if (!card) return;
  let reps = card.reps || 0;
  let interval = card.interval || 1;
  let ef = card.ef || 2.5;
  if (quality < 3) {
    reps = 0; interval = 1;
  } else {
    interval = reps === 0 ? 1 : reps === 1 ? 6 : Math.round(interval * ef);
    reps++;
  }
  ef = Math.max(1.3, ef + (0.1 - (5 - quality) * (0.08 + (5 - quality) * 0.02)));
  card.reps = reps; card.interval = interval; card.ef = ef;
  card.nextReview = Date.now() + (quality < 3 ? 60 * 1000 : interval * 86400000);
  await db.put('flashcards', card);
  state.fcFlipped = false;
  renderFlashcards();
}

/* ---------- الشرح والأبحاث + حل المسائل ---------- */
async function runExplainOrResearch() {
  const topic = $('exp-topic').value.trim();
  if (!topic) return toast('اكتب موضوع الدرس أو البحث');
  const bookId = $('exp-book-select').value;
  const mode = $('exp-mode').value;
  const provider = await db.getSetting('defaultProvider', 'gemini');
  const promptMap = {
    lesson: `اشرح الدرس التالي خطوة بخطوة مع أمثلة تطبيقية مبسطة:\n${topic}`,
    terms: `اشرح المصطلحات الصعبة التالية بلغة سهلة للطلاب:\n${topic}`,
    research: `نظّم مخطط بحث علمي للموضوع التالي مع أفكار ومراجع موثقة من الكتاب فقط دون اختلاق مراجع:\n${topic}`
  };
  const out = $('explain-output');
  out.classList.remove('hidden');
  out.textContent = 'جارٍ التحضير...';
  const res = await askAI({ prompt: promptMap[mode], bookId, provider });
  out.textContent = res.text;
}

async function solveProblem() {
  const problem = $('solver-input').value.trim();
  if (!problem && !state.solverImage.base64) return toast('اكتب المسألة أو أرفق صورتها');
  const bookId = $('solver-book-select').value;
  const provider = await db.getSetting('defaultProvider', 'gemini');
  const out = $('solver-output');
  out.classList.remove('hidden');
  out.textContent = 'جارٍ الحل بالتدرج...';
  const prompt = `حل المسألة التالية بالتدرج واذكر: 1) القانون المستخدم 2) خطوات الحل 3) التحقق من الناتج 4) الأخطاء الشائعة:\n${problem}`;
  const res = await askAI({
    prompt, bookId, provider,
    imageBase64: state.solverImage.base64, mimeType: state.solverImage.mimeType
  });
  out.textContent = res.text;
}

/* ---------- جدول الدراسة والمؤقت ---------- */
function renderTimer() {
  const m = String(Math.floor(state.timerSec / 60)).padStart(2, '0');
  const s = String(state.timerSec % 60).padStart(2, '0');
  $('timer-display').textContent = `${m}:${s}`;
}

async function renderTasks() {
  const tasks = await db.getAll('tasks');
  $('tasks-list').innerHTML = tasks.length
    ? tasks.map((t) => `
      <div class="item-row">
        <div class="item-top">
          <label class="inline-row">
            <input type="checkbox" data-toggle-task="${t.id}" ${t.done ? 'checked' : ''} style="width:auto;" />
            <strong style="${t.done ? 'text-decoration:line-through;opacity:.6' : ''}">${esc(t.title)}</strong>
          </label>
          <button class="btn btn-danger btn-sm" data-del-task="${t.id}">حذف</button>
        </div>
        <div class="meta">${esc(t.subject)} | ${esc(t.day)} — ${esc(t.time)}</div>
      </div>`).join('')
    : '<div class="meta">لا توجد مهام مجدولة بعد.</div>';
}

/* ---------- التقدم والدرجات ---------- */
async function renderProgress() {
  const scores = await db.getAll('scores');
  scores.sort((a, b) => a.ts - b.ts);
  $('scores-list').innerHTML = scores.length
    ? [...scores].reverse().map((s) => `<div class="item-row"><div class="item-top"><strong>${esc(s.title)}</strong><span class="badge">${s.percent}%</span></div><div class="meta">${esc(s.subject)}</div></div>`).join('')
    : '<div class="meta">لم تسجل أي درجات اختبارات بعد.</div>';

  const canvas = $('progress-chart');
  const ctx = canvas.getContext('2d');
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  if (!scores.length) {
    ctx.fillStyle = '#888';
    ctx.font = '16px sans-serif';
    ctx.fillText('لا توجد درجات لعرض الرسم البياني', 200, 120);
    return;
  }
  const pad = 32;
  const w = canvas.width - pad * 2;
  const h = canvas.height - pad * 2;
  ctx.strokeStyle = '#1d6ef2';
  ctx.lineWidth = 3;
  ctx.beginPath();
  scores.forEach((s, i) => {
    const x = pad + (scores.length === 1 ? w / 2 : (i / (scores.length - 1)) * w);
    const y = pad + h - (s.percent / 100) * h;
    if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
  });
  ctx.stroke();
  scores.forEach((s, i) => {
    const x = pad + (scores.length === 1 ? w / 2 : (i / (scores.length - 1)) * w);
    const y = pad + h - (s.percent / 100) * h;
    ctx.fillStyle = '#1d6ef2';
    ctx.beginPath(); ctx.arc(x, y, 5, 0, Math.PI * 2); ctx.fill();
  });
}

async function refreshCurrentView(page) {
  await populateBookSelects();
  if (page === 'home') await refreshHome();
  if (page === 'library') await renderLibrary();
  if (page === 'chat') await renderChatHistory();
  if (page === 'summary') await renderSummaries();
  if (page === 'quiz') await renderSavedQuizzes();
  if (page === 'flashcards') await renderFlashcards();
  if (page === 'planner') await renderTasks();
  if (page === 'progress') await renderProgress();
  if (page === 'settings') {
    $('set-provider').value = await db.getSetting('defaultProvider', 'gemini');
    $('set-proxy-url').value = await db.getSetting('proxyUrl', '');
  }
}

/* ---------- ربط الأحداث والتشغيل ---------- */
function readImageFile(file, targetObj, previewEl) {
  if (!file) return;
  const reader = new FileReader();
  reader.onload = () => {
    targetObj.base64 = reader.result;
    targetObj.mimeType = file.type || 'image/jpeg';
    previewEl.innerHTML = `<img src="${reader.result}" alt="صورة مرفقة" />`;
    previewEl.classList.remove('hidden');
  };
  reader.readAsDataURL(file);
}

async function boot() {
  updateNetworkBadge();
  window.addEventListener('online', updateNetworkBadge);
  window.addEventListener('offline', updateNetworkBadge);

  const isDark = await db.getSetting('darkMode', false);
  await applyTheme(isDark);

  const enterApp = () => {
    $('screen-splash').classList.add('hidden');
    $('app-shell').classList.remove('hidden');
    navigate('home');
  };
  $('btn-enter-app').onclick = enterApp;
  setTimeout(enterApp, 1100);

  $('btn-menu').onclick = () => $('drawer').classList.remove('hidden');
  $('btn-close-drawer').onclick = () => $('drawer').classList.add('hidden');
  $('btn-theme-top').onclick = async () => applyTheme(!document.body.classList.contains('dark'));

  document.addEventListener('click', async (e) => {
    const navBtn = e.target.closest('[data-nav]');
    if (navBtn) return navigate(navBtn.dataset.nav);

    const openBook = e.target.closest('[data-open-book]');
    if (openBook) { navigate('reader'); return openBookInReader(openBook.dataset.openBook); }

    const delBook = e.target.closest('[data-del-book]');
    if (delBook) { await db.deleteBookAndPages(delBook.dataset.delBook); toast('تم حذف الكتاب'); return renderLibrary(); }

    const jump = e.target.closest('[data-jump-page]');
    if (jump) { state.readerPage = Number(jump.dataset.jumpPage); return renderCurrentReaderPage(); }

    const delSum = e.target.closest('[data-del-sum]');
    if (delSum) { await db.del('summaries', delSum.dataset.delSum); return renderSummaries(); }

    const saveSum = e.target.closest('[data-save-sum]');
    if (saveSum) {
      const id = saveSum.dataset.saveSum;
      const item = await db.get('summaries', id);
      item.content = document.querySelector(`[data-edit-sum="${id}"]`).value;
      await db.put('summaries', item);
      return toast('تم حفظ التصحيح');
    }

    const runQ = e.target.closest('[data-run-quiz]');
    if (runQ) { const q = await db.get('quizzes', runQ.dataset.runQuiz); if (q) startQuiz(q); }

    const delQ = e.target.closest('[data-del-quiz]');
    if (delQ) { await db.del('quizzes', delQ.dataset.delQuiz); return renderSavedQuizzes(); }

    const rateFc = e.target.closest('[data-rate-fc]');
    if (rateFc) return rateFlashcard(rateFc.dataset.fcId, Number(rateFc.dataset.rateFc));

    const delTask = e.target.closest('[data-del-task]');
    if (delTask) { await db.del('tasks', delTask.dataset.delTask); return renderTasks(); }
  });

  document.addEventListener('change', async (e) => {
    if (e.target.dataset.toggleTask) {
      const t = await db.get('tasks', e.target.dataset.toggleTask);
      if (t) { t.done = e.target.checked; await db.put('tasks', t); renderTasks(); }
    }
  });

  $('book-file-input').onchange = (e) => handleBookImport(e.target.files[0]);
  $('lib-search').oninput = renderLibrary;
  $('lib-subject-filter').onchange = renderLibrary;

  $('reader-book-select').onchange = (e) => e.target.value && openBookInReader(e.target.value);
  $('btn-prev-page').onclick = () => { if (state.readerPage > 1) { state.readerPage--; renderCurrentReaderPage(); } };
  $('btn-next-page').onclick = () => { state.readerPage++; renderCurrentReaderPage(); };
  $('btn-zoom-in').onclick = () => { state.readerScale = Math.min(2.5, state.readerScale + 0.2); renderCurrentReaderPage(); };
  $('btn-zoom-out').onclick = () => { state.readerScale = Math.max(0.7, state.readerScale - 0.2); renderCurrentReaderPage(); };
  $('btn-reader-search').onclick = searchInsideReaderBook;
  $('btn-ask-page').onclick = () => {
    $('chat-book-select').value = state.readerBookId || '';
    $('chat-input').value = `اشرح لي صفحة ${state.readerPage} من هذا الكتاب بشكل مبسط.`;
    navigate('chat');
  };

  $('chat-image-input').onchange = (e) => readImageFile(e.target.files[0], state.chatImage, $('chat-image-preview'));
  $('btn-send-chat').onclick = sendChatMessage;
  $('btn-clear-chat').onclick = async () => {
    for (const c of await db.getAll('chats')) await db.del('chats', c.id);
    renderChatHistory();
  };

  $('btn-generate-summary').onclick = generateSummary;
  $('btn-generate-quiz').onclick = generateQuiz;

  $('btn-add-fc').onclick = async () => {
    const front = $('fc-front').value.trim();
    const back = $('fc-back').value.trim();
    if (!front || !back) return toast('اكتب السؤال والإجابة');
    await db.put('flashcards', { id: `fc_${Date.now()}`, front, back, nextReview: Date.now() });
    $('fc-front').value = ''; $('fc-back').value = '';
    toast('تمت إضافة البطاقة'); renderFlashcards();
  };
  $('btn-ai-fc').onclick = async () => {
    const bookId = $('fc-book-select').value;
    if (!bookId) return toast('اختر كتاباً أولاً');
    const pages = await db.getBookPages(bookId);
    if (navigator.onLine && (await db.getSetting('proxyUrl', ''))) {
      try {
        const res = await askAI({
          prompt: `استخرج 5 بطاقات حفظ بصيغة JSON فقط: [{"front":"سؤال","back":"إجابة"}]\nالنص:\n${pages.slice(0, 4).map((p) => p.text).join('\n').slice(0, 5000)}`,
          bookId, provider: await db.getSetting('defaultProvider', 'gemini')
        });
        const arr = parseAIJson(res.text);
        for (const item of arr) {
          await db.put('flashcards', { id: `fc_${Date.now()}_${Math.random()}`, front: item.front, back: item.back, nextReview: Date.now() });
        }
        toast(`تم توليد ${arr.length} بطاقات`);
        return renderFlashcards();
      } catch (err) { toast(err.message); }
    }
    toast('توليد البطاقات التلقائي يحتاج اتصالاً بالإنترنت وضبط الخادم الوسيط');
  };

  $('btn-run-explain').onclick = runExplainOrResearch;
  $('solver-image-input').onchange = (e) => readImageFile(e.target.files[0], state.solverImage, $('solver-image-preview'));
  $('btn-solve-problem').onclick = solveProblem;

  $('btn-timer-study').onclick = () => { clearInterval(state.timerInterval); state.timerInterval = null; state.timerSec = 25 * 60; renderTimer(); };
  $('btn-timer-break').onclick = () => { clearInterval(state.timerInterval); state.timerInterval = null; state.timerSec = 5 * 60; renderTimer(); };
  $('btn-timer-toggle').onclick = () => {
    if (state.timerInterval) { clearInterval(state.timerInterval); state.timerInterval = null; return; }
    state.timerInterval = setInterval(() => {
      if (state.timerSec > 0) { state.timerSec--; renderTimer(); }
      else { clearInterval(state.timerInterval); state.timerInterval = null; toast('انتهى وقت الجلسة!'); }
    }, 1000);
  };

  $('btn-add-task').onclick = async () => {
    const title = $('task-title').value.trim();
    if (!title) return toast('اكتب اسم المهمة');
    await db.put('tasks', {
      id: `t_${Date.now()}`, title,
      subject: $('task-subject').value.trim() || 'عام',
      day: $('task-day').value, time: $('task-time').value, done: false
    });
    $('task-title').value = '';
    renderTasks();
  };

  $('btn-save-settings').onclick = async () => {
    await applyTheme($('set-dark-mode').checked);
    await db.setSetting('defaultProvider', $('set-provider').value);
    await db.setSetting('proxyUrl', $('set-proxy-url').value.trim());
    toast('تم حفظ الإعدادات');
  };

  $('btn-export-backup').onclick = async () => {
    const json = await db.exportBackup();
    const blob = new Blob([json], { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `bashar-study-backup-${new Date().toISOString().slice(0, 10)}.json`;
    a.click();
  };

  $('import-backup-input').onchange = async (e) => {
    const file = e.target.files[0];
    if (!file) return;
    try {
      await db.importBackup(await file.text());
      toast('تمت استعادة النسخة الاحتياطية بنجاح');
      refreshCurrentView(state.currentPage);
    } catch (err) { toast(err.message); }
  };

  $('btn-wipe-data').onclick = async () => {
    if (!confirm('هل أنت متأكد من حذف جميع الكتب والدرجات والمحادثات؟')) return;
    await db.clearAll();
    toast('تم حذف جميع البيانات');
    navigate('home');
  };
}

boot();

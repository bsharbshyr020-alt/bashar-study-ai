/* ---------- الاختبارات ---------- */
async function generateQuiz() {
  const bookId = $('quiz-book-select').value;
  if (!bookId) return toast('اختر كتاباً أولاً');
  const book = await db.get('books', bookId);
  const type = $('quiz-type').value;
  const difficulty = $('quiz-difficulty').value;
  const count = Math.min(15, Math.max(3, Number($('quiz-count').value) || 5));
  const pages = await db.getBookPages(bookId);
  const sampleText = pages.slice(0, 8).map((p) => `[ص${p.page}] ${p.text}`).join('\n').slice(0, 7500);
  const provider = await db.getSetting('defaultProvider', 'gemini');

  let questions = [];
  if (navigator.onLine && (await db.getSetting('proxyUrl', ''))) {
    try {
      const prompt = `أنشئ اختباراً بصيغة JSON فقط (مصفوفة objects) من النص التالي.
النوع: ${type}, الصعوبة: ${difficulty}, العدد: ${count}.
كل عنصر يحتوي: {"q":"السؤال","type":"mcq|tf|fill|essay","options":["..."],"answer":"الإجابة الصحيحة","explanation":"التفسير ورقم الصفحة"}.
النص:\n${sampleText}`;
      const res = await askAI({ prompt, bookId, provider });
      questions = parseAIJson(res.text);
    } catch {
      questions = [];
    }
  }

  if (!Array.isArray(questions) || !questions.length) {
    questions = pages.slice(0, count).map((p, idx) => {
      const sentence = p.text.split(/[.!؟\n]/).find((s) => s.trim().length > 20) || p.text.slice(0, 90);
      return {
        q: `راجع العبارة من صفحة ${p.page}: هل وردت هذه الفكرة في الكتاب؟\n"${sentence.trim()}"`,
        type: 'tf',
        options: ['صح', 'خطأ'],
        answer: 'صح',
        explanation: `وردت في كتاب ${book.title} - صفحة ${p.page} (توليد محلي أوفلاين).`
      };
    });
  }

  const quiz = { id: `quiz_${Date.now()}`, title: `اختبار: ${book.title}`, subject: book.subject, questions, createdAt: Date.now() };
  await db.put('quizzes', quiz);
  renderSavedQuizzes();
  startQuiz(quiz);
}

function startQuiz(quiz) {
  const runner = $('quiz-runner');
  runner.classList.remove('hidden');
  runner.innerHTML = `
    <h4>${esc(quiz.title)}</h4>
    ${quiz.questions.map((item, i) => `
      <div class="item-row" style="margin-bottom:10px;">
        <strong>س${i + 1}: ${esc(item.q)}</strong>
        ${item.options?.length
          ? item.options.map((opt) => `<label class="inline-row"><input type="radio" name="q_${i}" value="${esc(opt)}" style="width:auto;" /> <span>${esc(opt)}</span></label>`).join('')
          : `<input type="text" id="q_text_${i}" placeholder="اكتب إجابتك..." />`}
        <div id="q_fb_${i}" class="meta hidden"></div>
      </div>`).join('')}
    <button id="btn-grade-quiz" class="btn btn-primary full">تصحيح الاختبار ومراجعة الإجابات</button>
    <div id="quiz-final-box" class="hidden" style="margin-top:12px;"></div>
  `;

  $('btn-grade-quiz').onclick = () => {
    let correct = 0;
    quiz.questions.forEach((item, i) => {
      const userAns = item.options?.length
        ? (document.querySelector(`input[name="q_${i}"]:checked`)?.value || '')
        : ($(`q_text_${i}`)?.value || '');
      const isOk = normalizeArabic(userAns) === normalizeArabic(item.answer);
      if (isOk) correct++;
      const fb = $(`q_fb_${i}`);
      fb.classList.remove('hidden');
      fb.innerHTML = `${isOk ? '✅ إجابة صحيحة' : '❌ غير مطابق'} — <b>الإجابة المعتمدة:</b> ${esc(item.answer)}<br/><i>${esc(item.explanation || '')}</i>`;
    });
    const percent = Math.round((correct / quiz.questions.length) * 100);
    const finalBox = $('quiz-final-box');
    finalBox.classList.remove('hidden');
    finalBox.innerHTML = `
      <div class="item-row">
        <strong>الدرجة المحسوبة: ${correct} / ${quiz.questions.length} (${percent}%)</strong>
        <small class="hint">تحقق من الأسئلة المقالية قبل اعتماد الدرجة النهائية.</small>
        <div class="inline-row">
          <input id="manual-percent" type="number" min="0" max="100" value="${percent}" />
          <button id="btn-save-score" class="btn btn-primary">اعتماد وحفظ الدرجة</button>
        </div>
      </div>`;
    $('btn-save-score').onclick = async () => {
      const finalPercent = Math.min(100, Math.max(0, Number($('manual-percent').value) || 0));
      await db.put('scores', { id: `sc_${Date.now()}`, title: quiz.title, subject: quiz.subject || 'عام', percent: finalPercent, ts: Date.now() });
      toast('تم حفظ الدرجة في سجل التقدم');
    };
  };
}


import { askAI, parseAIJson } from './ai-engine.js';

const PAGE_TITLES = {
  home: 'الرئيسية', library: 'مكتبة الكتب', reader: 'قارئ PDF',
  chat: 'المساعد الذكي', summary: 'التلخيص', quiz: 'الاختبارات',
  flashcards: 'الحفظ والبطاقات', explain: 'شرح الدروس والأبحاث',
  solver: 'حل المسائل والعلوم', planner: 'جدول الدراسة',
  progress: 'سجل الدرجات والتقدم', settings: 'الإعدادات والنسخ الاحتياطي'
};

const state = {
  currentPage: 'home',
  readerBookId: null,
  readerPage: 1,
  readerScale: 1.2,
  chatImage: { base64: '', mimeType: '' },
  solverImage: { base64: '', mimeType: '' },
  timerSec: 25 * 60,
  timerInterval: null,
  fcIndex: 0,
  fcFlipped: false
};

const $ = (id) => document.getElementById(id);
const esc = (s = '') => String(s)
  .replace(/&/g, '&amp;').replace(/</g, '&lt;')
  .replace(/>/g, '&gt;').replace(/"/g, '&quot;');

function toast(msg) {
  const el = $('toast');
  el.textContent = msg;
  el.classList.remove('hidden');
  clearTimeout(toast._t);
  toast._t = setTimeout(() => el.classList.add('hidden'), 2800);
}

function updateNetworkBadge() {
  const b = $('net-badge');
  if (navigator.onLine) {
    b.textContent = 'متصل';
    b.className = 'badge badge-online';
  } else {
    b.textContent = 'غير متصل';
    b.className = 'badge badge-offline';
  }
}

async function applyTheme(dark) {
  document.body.classList.toggle('dark', Boolean(dark));
  $('set-dark-mode').checked = Boolean(dark);
  $('btn-theme-top').textContent = dark ? '☀️' : '🌙';
  await db.setSetting('darkMode', Boolean(dark));
}

function navigate(page) {
  state.currentPage = page;
  document.querySelectorAll('.page').forEach((p) => p.classList.add('hidden'));
  $(`page-${page}`)?.classList.remove('hidden');
  $('page-title').textContent = PAGE_TITLES[page] || 'Bashar Study AI';

  document.querySelectorAll('[data-nav]').forEach((btn) => {
    btn.classList.toggle('active', btn.dataset.nav === page);
  });
  $('drawer').classList.add('hidden');
  refreshCurrentView(page);
}

async function populateBookSelects() {
  const books = await db.getAll('books');
  const ids = [
    'reader-book-select', 'chat-book-select', 'sum-book-select',
    'quiz-book-select', 'fc-book-select', 'exp-book-select', 'solver-book-select'
  ];
  for (const id of ids) {
    const sel = $(id);
    if (!sel) continue;
    const prev = sel.value;
    const firstOpt = id === 'chat-book-select'
      ? '<option value="">كل الكتب المحفوظة</option>'
      : '<option value="">-- اختر كتاباً --</option>';
    sel.innerHTML = firstOpt + books.map((b) => `<option value="${b.id}">${esc(b.title)} (${b.numPages} ص)</option>`).join('');
    if (prev) sel.value = prev;
  }
}

async function refreshHome() {
  const [books, cards, scores, tasks] = await Promise.all([
    db.getAll('books'), db.getAll('flashcards'), db.getAll('scores'), db.getAll('tasks')
  ]);
  const dueCards = cards.filter((c) => (c.nextReview || 0) <= Date.now());
  const avg = scores.length ? Math.round(scores.reduce((a, s) => a + s.percent, 0) / scores.length) : 0;
  const openTasks = tasks.filter((t) => !t.done);

  $('stat-books').textContent = books.length;
  $('stat-cards').textContent = dueCards.length;
  $('stat-avg').textContent = `${avg}%`;
  $('stat-tasks').textContent = openTasks.length;

  const lowScores = scores.filter((s) => s.percent < 70);
  const box = $('home-suggestions');
  if (!lowScores.length && !dueCards.length) {
    box.innerHTML = '<div class="meta">ممتاز! مستواك مستقر ولا توجد مراجعات متأخرة حالياً.</div>';
  } else {
    box.innerHTML = [
      ...lowScores.slice(0, 3).map((s) => `<div class="item-row"><strong>📌 إعادة مراجعة: ${esc(s.title)}</strong><span class="meta">درجتك السابقة ${s.percent}%</span></div>`),
      ...(dueCards.length ? [`<div class="item-row"><strong>🗂️ لديك ${dueCards.length} بطاقة حفظ حان وقت مراجعتها</strong></div>`] : [])
    ].join('');
  }
}

/* ---------- مكتبة الكتب ---------- */
async function handleBookImport(file) {
  if (!file) return;
  const prog = $('import-progress');
  prog.classList.remove('hidden');
  prog.textContent = 'جارٍ استيراد الملف واستخراج النصوص للعمل أوفلاين...';

  try {
    const id = `book_${Date.now()}`;
    const title = $('book-title').value.trim() || file.name.replace(/\.[^.]+$/, '');
    const subject = $('book-subject').value.trim() || 'عام';
    const grade = $('book-grade').value.trim() || 'غير محدد';
    const term = $('book-term').value.trim() || 'غير محدد';
    const isPdf = file.type === 'application/pdf' || file.name.toLowerCase().endsWith('.pdf');

    let buffer = null;
    let pages = [];
    let numPages = 1;

    if (isPdf) {
      buffer = await file.arrayBuffer();
      const res = await extractPdfPages(buffer, (curr, total) => {
        prog.textContent = `استخراج النصوص العربية: صفحة ${curr} من ${total}`;
      });
      numPages = res.numPages;
      pages = res.pages;
    } else {
      const txt = await file.text();
      pages = [{ page: 1, text: txt, norm: normalizeArabic(txt) }];
    }

    await db.put('books', {
      id, title, subject, grade, term, isPdf, numPages,
      lastPage: 1, buffer, createdAt: Date.now()
    });
    for (const p of pages) {
      await db.put('pages', { id: `${id}_p${p.page}`, bookId: id, ...p });
    }

    $('book-title').value = '';
    toast('تم حفظ الكتاب محلياً بنجاح');
    await populateBookSelects();
    await renderLibrary();
  } catch (e) {
    toast(`خطأ في استيراد الملف: ${e.message}`);
  } finally {
    prog.classList.add('hidden');
    $('book-file-input').value = '';
  }
}

async function renderLibrary() {
  const books = await db.getAll('books');
  const q = normalizeArabic($('lib-search').value);
  const subj = $('lib-subject-filter').value;

  const subjects = [...new Set(books.map((b) => b.subject).filter(Boolean))];
  const sel = $('lib-subject-filter');
  sel.innerHTML = '<option value="">كل المواد</option>' + subjects.map((s) => `<option value="${esc(s)}">${esc(s)}</option>`).join('');
  sel.value = subj;

  const filtered = [];
  for (const b of books) {
    if (subj && b.subject !== subj) continue;
    let matchHit = !q || normalizeArabic(b.title + ' ' + b.subject).includes(q);
    if (!matchHit && q) {
      const pages = await db.getBookPages(b.id);
      matchHit = pages.some((p) => p.norm.includes(q));
    }
    if (matchHit) filtered.push(b);
  }

  $('books-list').innerHTML = filtered.length
    ? filtered.map((b) => `
      <div class="item-row">
        <div class="item-top">
          <strong>${esc(b.title)}</strong>
          <span class="badge">متاح أوفلاين • ${b.numPages} ص</span>
        </div>
        <div class="meta">${esc(b.subject)} | ${esc(b.grade)} | الفصل: ${esc(b.term)} | آخر صفحة: ${b.lastPage || 1}</div>
        <div class="inline-row">
          <button class="btn btn-primary btn-sm" data-open-book="${b.id}">فتح القارئ</button>
          <button class="btn btn-danger btn-sm" data-del-book="${b.id}">حذف</button>
        </div>
      </div>`).join('')
    : '<div class="meta">لا توجد كتب بعد. استورد كتاب PDF من الأعلى.</div>';
}

/* ---------- قارئ PDF ---------- */
async function openBookInReader(bookId, pageNum = null) {
  const book = await db.get('books', bookId);
  if (!book) return;
  state.readerBookId = bookId;
  state.readerPage = pageNum || book.lastPage || 1;
  $('reader-book-select').value = bookId;
  await renderCurrentReaderPage();
}

async function renderCurrentReaderPage() {
  const book = await db.get('books', state.readerBookId);
  if (!book) return;
  const canvas = $('pdf-canvas');
  const txtView = $('txt-reader-view');

  if (book.isPdf && book.buffer) {
    canvas.classList.remove('hidden');
    txtView.classList.add('hidden');
    const info = await renderPdfPage(book.buffer, state.readerPage, canvas, state.readerScale);
    state.readerPage = info.currentPage;
    $('reader-page-info').textContent = `${info.currentPage} / ${info.totalPages}`;
  } else {
    canvas.classList.add('hidden');
    txtView.classList.remove('hidden');
    const pages = await db.getBookPages(book.id);
    txtView.textContent = pages[0]?.text || 'لا يوجد نص.';
    $('reader-page-info').textContent = '1 / 1';
  }
  book.lastPage = state.readerPage;
  await db.put('books', book);
}

async function searchInsideReaderBook() {
  if (!state.readerBookId) return toast('اختر كتاباً أولاً');
  const q = normalizeArabic($('reader-search-input').value);
  if (!q) return;
  const pages = await db.getBookPages(state.readerBookId);
  const hits = pages.filter((p) => p.norm.includes(q));
  $('reader-search-results').innerHTML = hits.length
    ? hits.map((h) => `<div class="search-hit" data-jump-page="${h.page}"><strong>صفحة ${h.page}:</strong> ${esc(h.text.slice(0, 140))}...</div>`).join('')
    : '<div class="meta">لم يتم العثور على نتائج مطابقة.</div>';
}


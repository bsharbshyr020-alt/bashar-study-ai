async function renderChatHistory() {
  const chats = await db.getAll('chats');
  chats.sort((a, b) => a.ts - b.ts);
  $('chat-messages').innerHTML = chats.length
    ? chats.map((m) => `<div class="msg ${m.role === 'user' ? 'msg-user' : 'msg-ai'}">${esc(m.text)}</div>`).join('')
    : '<div class="meta">ابدأ المحادثة بسؤال من كتابك أو أرفق صورة تمرين.</div>';
  $('chat-messages').scrollTop = $('chat-messages').scrollHeight;
}

async function sendChatMessage() {
  const text = $('chat-input').value.trim();
  if (!text && !state.chatImage.base64) return;
  const provider = $('chat-provider').value;
  const bookId = $('chat-book-select').value;

  await db.put('chats', { id: `m_${Date.now()}`, role: 'user', text: text || '📷 [صورة سؤال]', ts: Date.now() });
  $('chat-input').value = '';
  await renderChatHistory();

  try {
    const res = await askAI({
      prompt: text || 'اشرح وحل السؤال الموجود في الصورة خطوة بخطوة.',
      bookId,
      provider,
      imageBase64: state.chatImage.base64,
      mimeType: state.chatImage.mimeType
    });
    await db.put('chats', { id: `m_${Date.now() + 1}`, role: 'ai', text: res.text, ts: Date.now() + 1 });
  } catch (e) {
    await db.put('chats', { id: `m_${Date.now() + 1}`, role: 'ai', text: `❌ خطأ: ${e.message}`, ts: Date.now() + 1 });
  }
  state.chatImage = { base64: '', mimeType: '' };
  $('chat-image-preview').classList.add('hidden');
  $('chat-image-preview').innerHTML = '';
  await renderChatHistory();
}

/* ---------- التلخيص ---------- */
async function generateSummary() {
  const bookId = $('sum-book-select').value;
  if (!bookId) return toast('اختر كتاباً للتلخيص');
  const book = await db.get('books', bookId);
  const from = Number($('sum-from').value) || 1;
  const to = Number($('sum-to').value) || from + 4;
  const length = $('sum-length').value;
  const pages = (await db.getBookPages(bookId)).filter((p) => p.page >= from && p.page <= to);
  if (!pages.length) return toast('لا توجد نصوص في نطاق الصفحات المحدد');

  const combined = pages.map((p) => `[ص${p.page}] ${p.text}`).join('\n').slice(0, 9000);
  const provider = await db.getSetting('defaultProvider', 'gemini');
  let content = '';

  if (navigator.onLine && (await db.getSetting('proxyUrl', ''))) {
    const style = length === 'short' ? 'ملخص قصير جداً بنقاط مركزة' : length === 'medium' ? 'ملخص متوسط منظم بالأفكار الرئيسية' : 'ملخص مفصل يشمل الأفكار الرئيسية والتعريفات والقوانين المهمة';
    const res = await askAI({
      prompt: `أنشئ ${style} للنص التالي مع الإشارة إلى أرقام الصفحات:\n\n${combined}`,
      bookId,
      provider
    });
    content = res.text;
  } else {
    content = `📝 تلخيص محلي (وضع أوفلاين) لكتاب "${book.title}" (ص ${from}–${to}):\n\n` +
      pages.map((p) => `• صفحة ${p.page}: ${p.text.split(/[.!؟\n]/).slice(0, 3).join(' - ')}`).join('\n');
  }

  await db.put('summaries', {
    id: `sum_${Date.now()}`,
    title: `${book.title} (ص ${from}-${to})`,
    content,
    createdAt: Date.now()
  });
  toast('تم حفظ الملخص');
  renderSummaries();
}

